# Copy to .env (repo root) and fill in. Never commit .env.
# Read by: mmp/ (Reference Client, Build), pipeline/judge/, scripts/test_openai.py.

# --- Apertus on Swisscom (Swiss AI Weeks) — preferred chat model ------------------
# OpenAI-compatible; see docs/Example Curl Swiss API.txt. Base URL includes /v1.
# Takes precedence over PUBLIC_AI_* for the chat, and serves as the Judge's Apertus
# model when PUBLIC_AI_* is not set. Swisscom-hosted, so the client shows the
# "bleibt in der Schweiz" badge unless MMP_CHAT_SOVEREIGN=false.
SWISSCOM_API_KEY=
SWISSCOM_BASE_API=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
SWISSCOM_MODEL=swiss-ai/Apertus-v1.5-70B

# --- Swiss public AI (Public AI Inference Utility, OpenAI-compatible) -------------
# Alternative chat model if no Swisscom key is set.
# Docs: https://platform.publicai.co/docs  — models: https://platform.publicai.co/models
PUBLIC_AI_API_KEY=
PUBLIC_AI_BASE_URL=https://api.publicai.co/v1
PUBLIC_AI_MODEL=swiss-ai/apertus-v1.5-70b
# pipeline/judge also accepts a full endpoint instead of the base URL:
# PUBLIC_AI_ENDPOINT=https://api.publicai.co/v1/chat/completions

# Set to true only if the operator has confirmed that the chat endpoint keeps
# questions in Switzerland. It switches the client's badge to "Ihre Frage bleibt in
# der Schweiz" — the claim ADR-0002 says must never be made untruthfully.
# Unset = automatic (true for Swisscom, false otherwise).
MMP_CHAT_SOVEREIGN=

# --- OpenAI (optional) ------------------------------------------------------------
# Used by the Judge ensemble (pipeline/judge: OpenAI + Apertus) and, if nothing
# else is set, as the Build's extraction model. Build input is public web content,
# so a non-Swiss model is acceptable there (ADR-0002), never for the chat.
OPENAI_API_KEY=

# --- Build extraction model (optional override) -----------------------------------
# Defaults: PUBLIC_AI_* if set, else OPENAI_API_KEY with gpt-6-luna.
# MMP_BUILD_BASE_URL=https://api.openai.com/v1
# MMP_BUILD_API_KEY=
# MMP_BUILD_MODEL=gpt-6-luna

# --- Reference Client -------------------------------------------------------------
# Municipality shown first (BFS number). 4045 = Wettingen.
MMP_DEFAULT_BFS=4045
