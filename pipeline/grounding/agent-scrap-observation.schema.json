{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-scrap-observation.schema.json",
  "title": "Agent Scrap Tool Grounding Observations",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "municipality",
    "observations"
  ],
  "properties": {
    "schema": {
      "const": "agent-scrap-tool-observations/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "municipality": {
      "type": "string",
      "minLength": 1
    },
    "canton": {
      "type": [
        "string",
        "null"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool_id",
          "result",
          "source_refs"
        ],
        "properties": {
          "tool_id": {
            "type": "string",
            "minLength": 1
          },
          "service_lead_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "enum": [
              "supported",
              "not_observed",
              "reshape_contract",
              "local_capability",
              "reject_candidate"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "proposed_change": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
