{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service-lead.schema.json",
  "title": "Agent Scrap Service Lead",
  "type": "object",
  "required": [
    "schema",
    "service_lead_id",
    "labels",
    "service_type_hint",
    "authority",
    "sources",
    "discovery",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "service-lead/v1"
    },
    "service_lead_id": {
      "type": "string",
      "minLength": 1
    },
    "labels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "service_type_hint": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "required": [
        "country",
        "canton",
        "municipality"
      ],
      "properties": {
        "country": {
          "const": "CH"
        },
        "canton": {
          "type": "string",
          "minLength": 2
        },
        "municipality": {
          "type": "string",
          "minLength": 1
        },
        "department": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_ref",
          "url",
          "role"
        ],
        "properties": {
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "role": {
            "enum": [
              "service_page",
              "form",
              "application_pdf",
              "information_pdf",
              "calendar_pdf",
              "regulation_pdf",
              "contact_page",
              "related_page"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "discovery": {
      "type": "object",
      "required": [
        "confidence",
        "method",
        "evidence"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "candidate",
        "verified",
        "rejected"
      ]
    }
  },
  "additionalProperties": false
}
